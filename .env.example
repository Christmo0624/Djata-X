# ============================================================
# Fichier exemple — copiez ce fichier en .env et renseignez
# vos propres valeurs. Ne committez JAMAIS le fichier .env !
# ============================================================

# Exemple de variables Vite (préfixe VITE_ obligatoire pour
# qu'elles soient exposées côté client)
# VITE_API_URL=https://api.example.com
# VITE_PUBLIC_KEY=votre_clé_publique

# Exemples d'autres services (à ajouter selon vos besoins)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
